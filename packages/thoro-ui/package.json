{
  "name": "@thoro/ui",
  "version": "0.2.0-beta.0",
  "description": "Small, dependency-free web components for compliance-minded web apps. First up: tell users when their browser or network blocks the third-party resources your app depends on.",
  "keywords": [
    "ad-blocker",
    "compliance",
    "content-security-policy",
    "csp",
    "custom-element",
    "firewall",
    "web-component",
    "web-components"
  ],
  "homepage": "https://thoro.dev/",
  "license": "MIT",
  "author": "Haff",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TheHaff/thoro-ui.git",
    "directory": "packages/thoro-ui"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": [
    "./dist/*/element.js",
    "./dist/*/*.css"
  ],
  "exports": {
    "./res-canary": {
      "types": "./dist/res-canary/index.d.ts",
      "default": "./dist/res-canary/index.js"
    },
    "./res-canary/element": {
      "types": "./dist/res-canary/element.d.ts",
      "default": "./dist/res-canary/element.js"
    },
    "./res-canary/react": {
      "types": "./dist/res-canary/react.d.ts",
      "default": "./dist/res-canary/react.js"
    },
    "./res-canary/react.css": {
      "types": "./dist/res-canary/react.css.d.ts",
      "default": "./dist/res-canary/react.css"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "vp test",
    "test:browser": "pnpm run build && pnpm run build:fixtures && playwright test",
    "typecheck": "tsc -p .",
    "build": "vp pack && node scripts/build-react-css.ts",
    "prepack": "pnpm run build",
    "size": "size-limit",
    "test:ssr": "node test/ssr.ts",
    "test:types": "tsc -p test/types",
    "build:fixtures": "vp build --config vite.fixtures.config.ts"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@size-limit/preset-small-lib": "14.1.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "happy-dom": "20.14.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "size-limit": "14.1.0"
  },
  "peerDependencies": {
    "react": "^19.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  }
}
