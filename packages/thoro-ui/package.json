{
  "name": "thoro-ui",
  "version": "0.0.0",
  "description": "Small, dependency-free web components for compliance-minded web apps. First up: tell users when their browser or network blocks the third-party resources your app depends on.",
  "keywords": [
    "ad-blocker",
    "compliance",
    "content-security-policy",
    "csp",
    "custom-element",
    "firewall",
    "web-component",
    "web-components"
  ],
  "license": "MIT",
  "author": "Haff",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TheHaff/thoro-ui.git",
    "directory": "packages/thoro-ui"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": [
    "./dist/*/element.js"
  ],
  "exports": {
    "./res-canary": {
      "types": "./dist/res-canary/index.d.ts",
      "default": "./dist/res-canary/index.js"
    },
    "./res-canary/element": {
      "types": "./dist/res-canary/element.d.ts",
      "default": "./dist/res-canary/element.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "test": "vp test",
    "test:browser": "vp pack && playwright test",
    "typecheck": "tsc -p .",
    "build": "vp pack",
    "prepack": "vp pack",
    "size": "size-limit",
    "test:ssr": "node test/ssr.ts"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@size-limit/preset-small-lib": "14.1.0",
    "happy-dom": "20.14.5",
    "size-limit": "14.1.0"
  }
}
